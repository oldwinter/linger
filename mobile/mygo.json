{
  "name": "Linger",
  "identifier": "ai.linger.mobile",
  "version": "0.1.0",
  "main": "./cmd/linger-mobile",
  "icon": "./resources/icon.png",
  "urlSchemes": ["linger"],
  "ios": {
    "orientations": ["portrait", "landscape"],
    "infoPlist": {
      "NSLocalNetworkUsageDescription": "Linger discovers your Linger Desktop host on the local network.",
      "NSBonjourServices": ["_linger._tcp"],
      "NSCameraUsageDescription": "Scan the pairing QR code shown on Linger Desktop.",
      "NSFaceIDUsageDescription": "Unlock Linger Mobile and protect your paired desktop credentials."
    }
  },
  "android": {
    "minSdk": 26,
    "adaptiveIcon": {
      "foreground": "./resources/icon-foreground.png",
      "background": "#FDFDFB"
    },
    "permissions": [
      "android.permission.INTERNET",
      "android.permission.ACCESS_NETWORK_STATE",
      "android.permission.CHANGE_WIFI_MULTICAST_STATE",
      "android.permission.CAMERA",
      "android.permission.USE_BIOMETRIC"
    ]
  }
}
