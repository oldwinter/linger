{
  "name": "LingerX",
  "identifier": "dev.oldwinter.lingerx.mobile",
  "version": "0.1.0",
  "main": "./cmd/linger-mobile",
  "icon": "./resources/icon.png",
  "urlSchemes": ["lingerx", "linger"],
  "ios": {
    "orientations": ["portrait", "landscape"],
    "launchScreen": {
      "background": "#F5F4EF"
    },
    "infoPlist": {
      "CFBundleLocalizations": ["en", "zh-Hans"],
      "NSLocalNetworkUsageDescription": "LingerX discovers your LingerX Desktop host on the local network.",
      "NSBonjourServices": ["_linger._tcp"],
      "NSCameraUsageDescription": "Scan the pairing QR code shown on LingerX Desktop.",
      "NSFaceIDUsageDescription": "Unlock LingerX Mobile and protect your paired desktop credentials."
    }
  },
  "android": {
    "minSdk": 26,
    "splash": "#F5F4EF",
    "adaptiveIcon": {
      "foreground": "./resources/icon-foreground.png",
      "background": "#F5F4EF"
    },
    "permissions": [
      "android.permission.INTERNET",
      "android.permission.ACCESS_NETWORK_STATE",
      "android.permission.CHANGE_WIFI_MULTICAST_STATE",
      "android.permission.CAMERA",
      "android.permission.USE_BIOMETRIC"
    ]
  }
}
